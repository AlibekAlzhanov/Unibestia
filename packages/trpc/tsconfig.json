{
  "extends": "@repo/typescript-config/base.json",
  "compilerOptions": {
    "target": "ES2020",
    "outDir": "dist",
    "rootDir": "./src",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "paths": {
      "@/*": ["./src/*"],
      "@repo/ui/*": ["../../packages/ui/src/*"],
      "@repo/backend/*": ["../../apps/backend/src/*"],
      "@repo/web/*": ["../../apps/web/src/*"],
      "@repo/mobile/*": ["../../apps/mobile/src/*"],
      "@repo/api-client/*": ["../../packages/api-client/src/*"],
      "@repo/db/*": ["../../packages/db/src/*"],
      "@repo/services/*": ["../../packages/services/src/*"],
      "@repo/trpc/*": ["../../packages/trpc/src/*"],
      "@repo/eslint-config/*": ["../../packages/eslint-config/src/*"],
      "@repo/analytics/*": ["../../packages/analytics/src/*"]
    }
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}