# Android Emulator:
# localhost inside emulator points to emulator itself, so use 10.0.2.2.
EXPO_PUBLIC_API_URL=http://10.0.2.2:3001
EXPO_PUBLIC_TRPC_URL=http://10.0.2.2:3001/trpc

# Physical device example:
# EXPO_PUBLIC_API_URL=http://192.168.0.10:3001
# EXPO_PUBLIC_TRPC_URL=http://192.168.0.10:3001/trpc

# Clerk
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_me

# PostHog analytics
# Leave empty for local demo if analytics is not required.
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://app.posthog.com
